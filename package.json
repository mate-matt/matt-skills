{
  "name": "matt-skills",
  "version": "0.1.0",
  "description": "Codex skills and companion CLIs for creator publishing workflows.",
  "private": true,
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "fxbrief:build": "npm --prefix packages/fxbrief run build",
    "fxbrief:dev": "npm --prefix packages/fxbrief run dev --",
    "fxbrief:pack": "cd packages/fxbrief && npm pack --dry-run --workspaces=false",
    "fxbrief:render:fixture": "npm --prefix packages/fxbrief run render:fixture",
    "fxbrief:test": "npm --prefix packages/fxbrief test",
    "fxbrief:typecheck": "npm --prefix packages/fxbrief run typecheck",
    "playwright:install": "npx playwright install chromium",
    "pic:help": "bun run skills/matt-pic-grab-image/scripts/grab-image.ts --help",
    "pic:random": "bun run skills/matt-pic-grab-image/scripts/grab-image.ts --random --mode strict_cc0 --orientation landscape",
    "pic:shanshui": "bun run skills/matt-pic-grab-image/scripts/grab-image.ts --query '山水' --fallback-query 'Chinese landscape painting' --mode strict_cc0 --provider met,openverse --orientation landscape --count 1 --seed shanshui-commercial-safe",
    "pic:history": "bun run skills/matt-pic-grab-image/scripts/grab-image.ts --query 'history painting' --mode strict_cc0 --orientation landscape --count 1",
    "validate:skills": "bun run scripts/validate-skill.mjs skills/matt-pic-grab-image && bun run scripts/validate-skill.mjs skills/matt-fx-brief-material-renderer",
    "validate:fxbrief-skill": "bun run scripts/validate-skill.mjs skills/matt-fx-brief-material-renderer",
    "validate:fxbrief-skill:official": "python3 ${CODEX_HOME:-$HOME/.codex}/skills/.system/skill-creator/scripts/quick_validate.py skills/matt-fx-brief-material-renderer",
    "validate:pic-skill": "bun run scripts/validate-skill.mjs skills/matt-pic-grab-image",
    "validate:pic-skill:official": "python3 ${CODEX_HOME:-$HOME/.codex}/skills/.system/skill-creator/scripts/quick_validate.py skills/matt-pic-grab-image"
  },
  "engines": {
    "bun": ">=1.0.0",
    "node": ">=20"
  }
}
